{
  "name": "devlingo-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Site de apresentação do Devlingo (estático, sem servidor).",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && astro dev",
    "check": "npm run sync && astro check",
    "build": "npm run sync && astro check && astro build",
    "audit:dist": "node scripts/audit-dist.mjs",
    "audit:selftest": "node scripts/audit-selftest.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run build && npm run audit:dist && npm run audit:selftest && npm run e2e",
    "preview": "astro preview",
    "certificado": "node scripts/certificado.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@types/node": "26.6.6",
    "astro": "7.4.11",
    "axe-core": "4.14.0",
    "parse5": "8.1.1",
    "puppeteer-core": "25.17.0",
    "typescript": "6.0.3"
  }
}
