---
import { inlineSvg } from "../lib/brand";
import { REPO_URL } from "../lib/site";

const logoLight = inlineSvg("logo/logo-horizontal.svg", "hl", 'role="img" aria-label="Devlingo" class="logo logo-light"');
const logoDark = inlineSvg("logo/logo-horizontal-on-dark.svg", "hd", 'role="img" aria-label="Devlingo" class="logo logo-dark"');
---

<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="wrap top">
  <a href="/" aria-label="Devlingo, início"><Fragment set:html={logoLight} /><Fragment set:html={logoDark} /></a>
  <nav aria-label="Seções">
    <a class="nav-hide" href="#como-funciona">Como funciona</a>
    <a class="nav-hide" href="#assuntos">Assuntos</a>
    <a class="nav-hide" href="#certificados">Certificados</a>
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
    <!-- No celular o botão mostra um ícone e a escolha curta ("auto"); a palavra "Tema:" fica só para leitores de tela.
         O texto que muda a cada clique é escrito por scripts/theme.ts. -->
    <button type="button" class="theme" id="theme-toggle">
      <svg class="theme-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M12 3.5a8.5 8.5 0 0 0 0 17z" fill="currentColor" /></svg><span class="theme-pre">Tema: </span><span class="theme-long" id="theme-long">automático</span><span class="theme-short" id="theme-short">auto</span>
    </button>
  </nav>
</header>

<script>
  import "../scripts/theme";
</script>
