# Token do bot: Discord Developer Portal > Bot > Reset Token.
# Nunca suba o arquivo .env para o GitHub (ele já está no .gitignore).
DISCORD_TOKEN=

# --- Opcionais (os valores abaixo são os padrões) ---

# Nos servidores, o bot só responde nesse canal (DMs sempre funcionam). Vazio = qualquer canal.
ALLOWED_CHANNEL_ID=

# Máximo de XP por pessoa por dia. 0 = sem limite.
# DAILY_XP_CAP=200

# Respostas por dia que cumprem a meta diária (+15 XP). 0 = sem meta.
# DAILY_GOAL=5

# Fuso que define "o dia" da sequência e do limite diário de XP (nome IANA).
# TIMEZONE=America/Sao_Paulo

# Onde fica o banco SQLite. Padrão: data/devlingo.db na raiz do projeto.
# DB_PATH=
